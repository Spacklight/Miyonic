{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miyoni-hq",
  "main": "worker.js",
  "compatibility_date": "2026-03-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "miyoni",
      "database_id": "a78a2863-9153-46ca-9b78-9a59c88b3b3d"
    }
  ],
  "vars": {
    "ADMIN_EMAIL": "prof200619@gmail.com",
    "SITE_URL": "https://miyoni.de5.net",
    "SITE_NAME": "MIYONI",
    "DEFAULT_OG_IMAGE": "https://miyoni.de5.net/assets/founder-office.png"
  }
}
